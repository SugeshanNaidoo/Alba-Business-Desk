# Copy the values you need into Vercel's Environment Variables settings —
# this file is just a reference, don't commit a real .env with actual secrets.

# Instagram (Meta Graph API)
IG_ACCESS_TOKEN=
IG_BUSINESS_ACCOUNT_ID=

# Facebook (Meta Graph API)
FB_PAGE_ACCESS_TOKEN=
FB_PAGE_ID=

# TikTok
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REFRESH_TOKEN=

# Optional — restrict which site can call these endpoints
ALLOWED_ORIGIN=https://your-crm-domain.vercel.app
