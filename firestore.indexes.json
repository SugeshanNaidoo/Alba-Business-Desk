{
  "//": [
    "Composite indexes for the organisation-based data model (dataModelVersion 2).",
    "Single-field indexes are created automatically by Firestore and are NOT listed here.",
    "",
    "Deploy with:  firebase deploy --only firestore:indexes",
    "",
    "These are not all needed until their corresponding migration phase ships.",
    "Deploying them early is harmless (an unused index costs only storage) and",
    "avoids the failure mode where a query 400s in production while the index",
    "builds — index builds on a populated collection are not instant.",
    "",
    "Note on collectionGroup entries: 'messages' is a subcollection under each",
    "conversation, so any query spanning conversations requires a collection",
    "group index rather than a collection index."
  ],

  "indexes": [
    {
      "//": "Phase 4 — contact list, newest-touched first, within one org.",
      "collectionGroup": "contacts",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "status", "order": "ASCENDING" },
        { "fieldPath": "updatedAt", "order": "DESCENDING" }
      ]
    },
    {
      "//": "Phase 4 — paginated contact list ordered by name.",
      "collectionGroup": "contacts",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "lastName", "order": "ASCENDING" },
        { "fieldPath": "firstName", "order": "ASCENDING" }
      ]
    },
    {
      "//": "Phase 5 — contacts belonging to one company.",
      "collectionGroup": "contacts",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "companyId", "order": "ASCENDING" },
        { "fieldPath": "updatedAt", "order": "DESCENDING" }
      ]
    },

    {
      "//": "Phase 6 — kanban board: deals in one stage, highest value first.",
      "collectionGroup": "deals",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "stage", "order": "ASCENDING" },
        { "fieldPath": "value", "order": "DESCENDING" }
      ]
    },
    {
      "//": "Phase 6 — 'my deals' view / per-rep reporting.",
      "collectionGroup": "deals",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "assignedTo", "order": "ASCENDING" },
        { "fieldPath": "stage", "order": "ASCENDING" }
      ]
    },
    {
      "//": "Phase 6 — forecasting: open deals by expected close date.",
      "collectionGroup": "deals",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "stage", "order": "ASCENDING" },
        { "fieldPath": "expectedCloseDate", "order": "ASCENDING" }
      ]
    },
    {
      "//": "Phase 6 — deals linked to one contact (contact drawer).",
      "collectionGroup": "deals",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "contactId", "order": "ASCENDING" },
        { "fieldPath": "updatedAt", "order": "DESCENDING" }
      ]
    },

    {
      "//": "Phase 7 — open tasks by due date (the default Tasks view).",
      "collectionGroup": "tasks",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "status", "order": "ASCENDING" },
        { "fieldPath": "dueDate", "order": "ASCENDING" }
      ]
    },
    {
      "//": "Phase 7 — tasks assigned to one member, soonest first.",
      "collectionGroup": "tasks",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "assignedTo", "order": "ASCENDING" },
        { "fieldPath": "status", "order": "ASCENDING" },
        { "fieldPath": "dueDate", "order": "ASCENDING" }
      ]
    },

    {
      "//": "Phase 8 — activity timeline for one contact (contact drawer).",
      "collectionGroup": "activities",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "contactId", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    {
      "//": "Phase 8 — activity timeline for one deal.",
      "collectionGroup": "activities",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "dealId", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    {
      "//": "Phase 8 — filtered activity feed (e.g. calls only).",
      "collectionGroup": "activities",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "type", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },

    {
      "//": "Phase 9 — calendar month grid: events within a date window.",
      "collectionGroup": "calendarEvents",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "start", "order": "ASCENDING" },
        { "fieldPath": "end", "order": "ASCENDING" }
      ]
    },
    {
      "//": "Phase 9 — events linked to one contact.",
      "collectionGroup": "calendarEvents",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "contactId", "order": "ASCENDING" },
        { "fieldPath": "start", "order": "ASCENDING" }
      ]
    },

    {
      "//": "Phase 11 — WhatsApp inbox: open conversations, most recent first.",
      "collectionGroup": "conversations",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "status", "order": "ASCENDING" },
        { "fieldPath": "lastMessageAt", "order": "DESCENDING" }
      ]
    },
    {
      "//": "Phase 11 — conversations assigned to one member.",
      "collectionGroup": "conversations",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "assignedTo", "order": "ASCENDING" },
        { "fieldPath": "lastMessageAt", "order": "DESCENDING" }
      ]
    },
    {
      "//": "Phase 11 — collection group: find a conversation by phone number across the org (webhook inbound routing).",
      "collectionGroup": "conversations",
      "queryScope": "COLLECTION_GROUP",
      "fields": [
        { "fieldPath": "phoneNumber", "order": "ASCENDING" },
        { "fieldPath": "lastMessageAt", "order": "DESCENDING" }
      ]
    },
    {
      "//": "Phase 11 — messages within a conversation, oldest first (thread view). Collection group because messages live under each conversation.",
      "collectionGroup": "messages",
      "queryScope": "COLLECTION_GROUP",
      "fields": [
        { "fieldPath": "direction", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "ASCENDING" }
      ]
    },

    {
      "//": "Phase 12 — files attached to one contact.",
      "collectionGroup": "files",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "contactId", "order": "ASCENDING" },
        { "fieldPath": "uploadedAt", "order": "DESCENDING" }
      ]
    },
    {
      "//": "Phase 12 — files attached to one deal.",
      "collectionGroup": "files",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "dealId", "order": "ASCENDING" },
        { "fieldPath": "uploadedAt", "order": "DESCENDING" }
      ]
    },

    {
      "//": "Phase 13 — audit log filtered by action type, newest first.",
      "collectionGroup": "auditLogs",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "action", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    {
      "//": "Phase 13 — audit log for one member's actions.",
      "collectionGroup": "auditLogs",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "performedBy", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },

    {
      "//": "Phase 2 — find every organisation a user belongs to (org switcher). Collection group across all members subcollections.",
      "collectionGroup": "members",
      "queryScope": "COLLECTION_GROUP",
      "fields": [
        { "fieldPath": "uid", "order": "ASCENDING" },
        { "fieldPath": "status", "order": "ASCENDING" }
      ]
    }
  ],

  "fieldOverrides": []
}
