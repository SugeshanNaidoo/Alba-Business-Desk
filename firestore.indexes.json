{
  "//": [
    "Composite indexes for the organisation-based data model (dataModelVersion 2).",
    "Single-field indexes are created automatically by Firestore and are NOT listed here.",
    "",
    "Deploy with:  firebase deploy --only firestore:indexes",
    "",
    "These are not all needed until their corresponding migration phase ships.",
    "Deploying them early is harmless (an unused index costs only storage) and",
    "avoids the failure mode where a query 400s in production while the index",
    "builds \u2014 index builds on a populated collection are not instant.",
    "",
    "Note on collectionGroup entries: 'messages' is a subcollection under each",
    "conversation, so any query spanning conversations requires a collection",
    "group index rather than a collection index.",
    "Single-field indexes are created automatically by Firestore in both directions and must NOT be listed here \u2014 the console rejects them as redundant. Only multi-field composites belong in this file."
  ],
  "indexes": [
    {
      "//": "Phase 4 \u2014 contact list, newest-touched first, within one org.",
      "collectionGroup": "contacts",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "status",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "updatedAt",
          "order": "DESCENDING"
        }
      ]
    },
    {
      "//": "Phase 4 \u2014 paginated contact list ordered by name.",
      "collectionGroup": "contacts",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "lastName",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "firstName",
          "order": "ASCENDING"
        }
      ]
    },
    {
      "//": "Phase 5 \u2014 contacts belonging to one company.",
      "collectionGroup": "contacts",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "companyId",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "updatedAt",
          "order": "DESCENDING"
        }
      ]
    },
    {
      "//": "Phase 6 \u2014 kanban board: deals in one stage, highest value first.",
      "collectionGroup": "deals",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "stage",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "value",
          "order": "DESCENDING"
        }
      ]
    },
    {
      "//": "Phase 6 \u2014 'my deals' view / per-rep reporting.",
      "collectionGroup": "deals",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "assignedTo",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "stage",
          "order": "ASCENDING"
        }
      ]
    },
    {
      "//": "Phase 6 \u2014 forecasting: open deals by expected close date.",
      "collectionGroup": "deals",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "stage",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "expectedCloseDate",
          "order": "ASCENDING"
        }
      ]
    },
    {
      "//": "Phase 6 \u2014 deals linked to one contact (contact drawer).",
      "collectionGroup": "deals",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "contactId",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "updatedAt",
          "order": "DESCENDING"
        }
      ]
    },
    {
      "//": "Phase 7 \u2014 open tasks by due date (the default Tasks view).",
      "collectionGroup": "tasks",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "status",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "dueDate",
          "order": "ASCENDING"
        }
      ]
    },
    {
      "//": "Phase 7 \u2014 tasks assigned to one member, soonest first.",
      "collectionGroup": "tasks",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "assignedTo",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "status",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "dueDate",
          "order": "ASCENDING"
        }
      ]
    },
    {
      "//": "Filtered activity feed (e.g. calls only), newest first.",
      "collectionGroup": "activities",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "type",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "timestamp",
          "order": "DESCENDING"
        }
      ]
    },
    {
      "//": "Phase 9 \u2014 calendar month grid: events within a date window.",
      "collectionGroup": "calendarEvents",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "start",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "end",
          "order": "ASCENDING"
        }
      ]
    },
    {
      "//": "Phase 9 \u2014 events linked to one contact.",
      "collectionGroup": "calendarEvents",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "contactId",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "start",
          "order": "ASCENDING"
        }
      ]
    },
    {
      "//": "Phase 12 \u2014 files attached to one contact.",
      "collectionGroup": "files",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "contactId",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "uploadedAt",
          "order": "DESCENDING"
        }
      ]
    },
    {
      "//": "Phase 12 \u2014 files attached to one deal.",
      "collectionGroup": "files",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "dealId",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "uploadedAt",
          "order": "DESCENDING"
        }
      ]
    },
    {
      "//": "Phase 13 \u2014 audit log filtered by action type, newest first.",
      "collectionGroup": "auditLogs",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "action",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "createdAt",
          "order": "DESCENDING"
        }
      ]
    },
    {
      "//": "Phase 13 \u2014 audit log for one member's actions.",
      "collectionGroup": "auditLogs",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "performedBy",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "createdAt",
          "order": "DESCENDING"
        }
      ]
    },
    {
      "//": "Phase 2 \u2014 find every organisation a user belongs to (org switcher). Collection group across all members subcollections.",
      "collectionGroup": "members",
      "queryScope": "COLLECTION_GROUP",
      "fields": [
        {
          "fieldPath": "uid",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "status",
          "order": "ASCENDING"
        }
      ]
    },
    {
      "//": "loadActivityFor() \u2014 a record's own timeline, newest first.",
      "collectionGroup": "activities",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "relatedType",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "relatedId",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "timestamp",
          "order": "DESCENDING"
        }
      ]
    },
    {
      "//": "Last-owner protection \u2014 counts active owners inside a transaction before a demotion or removal. Without this the guard throws and the operation is blocked.",
      "collectionGroup": "members",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "role",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "status",
          "order": "ASCENDING"
        }
      ]
    },
    {
      "//": "Invite lookup \u2014 finds an existing member by email when re-inviting someone previously removed.",
      "collectionGroup": "members",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "email",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "status",
          "order": "ASCENDING"
        }
      ]
    }
  ],
  "fieldOverrides": []
}